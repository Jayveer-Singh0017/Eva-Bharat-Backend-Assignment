PORT=8080

# Database connection: supports MySQL, PostgreSQL, or embedded H2 (default if omitted)
# MySQL format:
DATABASE_URL=mysql://root:password@localhost:3306/media
# PostgreSQL format:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Comma-separated list of exact origins allowed to call this API (CORS).
ALLOWED_ORIGIN=http://localhost:5173,https://your-frontend.onrender.com
